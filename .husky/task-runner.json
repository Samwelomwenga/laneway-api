{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
     {
       "name": "dotnet-format",
       "group": "pre-commit",
       "command": "dotnet",
       "args": ["format", "whitespace", "--folder", "--verify-no-changes", "--include", "${staged}"],
       "include": ["**/*.cs"]
     },
     {
       "name": "check-secrets",
       "group": "pre-commit",
       "command": "bash",
       "args": ["scripts/check-secrets.sh"]
     },
     {
       "name": "format-solution",
       "group": "pre-push",
       "command": "dotnet",
       "args": ["format", "Laneway.Api.sln", "--verify-no-changes"]
     },
     {
       "name": "commit-message-linter",
       "group": "commit-msg",
       "command": "dotnet",
       "args": [
         "husky",
         "exec",
         ".husky/csx/commit-lint.csx",
         "--args",
         "${args}"
       ]
     }
   ]
}
