<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Laneway.Api.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <UserSecretsId>0e838897-61eb-4e95-aa86-b5dad1c4e8e2</UserSecretsId>
        <AnalysisMode>All</AnalysisMode>
        <NoWarn>$(NoWarn);CA1001;CA1002;CA1014;CA1515;CA1707;CA1711;CA2007;CA2234</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
