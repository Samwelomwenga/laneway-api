POST {{prodigy_board_API_HostAddress}}/api/v1/cards/{{linkCard}}/attachments
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "url": "https://example.com/spec",
  "name": "The spec"
}

> {% client.global.set("linkAttachment", response.body.data.id); %}

