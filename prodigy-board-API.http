### Archive the card, so it can be deleted.
PUT {{prodigy_board_API_HostAddress}}/api/v1/cards/{{checklistCascadeCard}}/archived
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "value": true
}

### Delete the card. 204, and its live checklist goes with it.
DELETE {{prodigy_board_API_HostAddress}}/api/v1/cards/{{checklistCascadeCard}}
X-User-Id: {{actorId}}

### Read the checklist the deleted card held. 404, so the foreign key cascaded.
GET {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistCascade}}
