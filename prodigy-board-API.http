### Delete an unknown attachment. 404.
DELETE {{prodigy_board_API_HostAddress}}/api/v1/cards/{{attachmentDeleteCard}}/attachments/11111111-1111-1111-1111-111111111111
X-User-Id: {{actorId}}

### Delete through the wrong card. 404.
DELETE {{prodigy_board_API_HostAddress}}/api/v1/cards/{{attachmentOtherCard}}/attachments/{{attachmentDoomed}}
X-User-Id: {{actorId}}

### Delete it. 204, with no archive step, because attachments have no archive. The trigger queues the
### object key, and the drainer removes the object from the bucket within a minute.
DELETE {{prodigy_board_API_HostAddress}}/api/v1/cards/{{attachmentDeleteCard}}/attachments/{{attachmentDoomed}}
X-User-Id: {{actorId}}

### Read the deleted attachment. 404.
GET {{prodigy_board_API_HostAddress}}/api/v1/cards/{{attachmentDeleteCard}}/attachments/{{attachmentDoomed}}

### Download the deleted attachment. 404.
GET {{prodigy_board_API_HostAddress}}/api/v1/cards/{{attachmentDeleteCard}}/attachments/{{attachmentDoomed}}/content

### Delete it again. 404.
DELETE {{prodigy_board_API_HostAddress}}/api/v1/cards/{{attachmentDeleteCard}}/attachments/{{attachmentDoomed}}
X-User-Id: {{actorId}}

### Create the card whose delete has to take its files with it.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "Cascade card",
  "listId": "{{attachmentList}}",
  "isDueComplete": false
}

