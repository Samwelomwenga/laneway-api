PUT {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistFollowUp}}/archived
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "value": true,
  "name": "Renamed by an archive"
}

### Create the board the ancestor checks archive.
POST {{prodigy_board_API_HostAddress}}/api/v1/boards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "name": "Checklist board two",
  "workspaceId": "{{checklistWorkspaceId}}",
  "visibility": "Private"
}

> {% client.global.set("checklistBoardTwo", response.body.data.id); %}

### Create the list the ancestor checks archive.
POST {{prodigy_board_API_HostAddress}}/api/v1/lists
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "name": "Checklist list two",
  "boardId": "{{checklistBoardTwo}}"
}

> {% client.global.set("checklistListTwo", response.body.data.id); %}

### Create the card the ancestor checks archive.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "Ancestor card",
  "listId": "{{checklistListTwo}}",
  "isDueComplete": false
}

> {% client.global.set("checklistCardTwo", response.body.data.id); %}

### Create the checklist the ancestor checks write to.
POST {{prodigy_board_API_HostAddress}}/api/v1/checklists
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "name": "Steps",
  "cardId": "{{checklistCardTwo}}"
}

> {% client.global.set("checklistSteps", response.body.data.id); %}

### Archive the card. Its checklist keeps its own flag off.
PUT {{prodigy_board_API_HostAddress}}/api/v1/cards/{{checklistCardTwo}}/archived
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "value": true
}

### Create a checklist on the archived card. 409 archived on cardId.
POST {{prodigy_board_API_HostAddress}}/api/v1/checklists
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "name": "More steps",
  "cardId": "{{checklistCardTwo}}"
}

### Rename the checklist on the archived card. 409 archived with a null field, "The card this checklist is on is archived."
PUT {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistSteps}}
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "name": "Steps renamed"
}

### Archive the checklist on the archived card. 409 archived, because an archived ancestor blocks the archive endpoint too. Restore the card first.
PUT {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistSteps}}/archived
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "value": true
}

### Delete the checklist on the archived card. 409 archived, not notArchived, because the ancestor check runs first.
DELETE {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistSteps}}
X-User-Id: {{actorId}}

### Read the archived card's checklists. 200 with empty data, because exclude hides checklists on hidden cards.
GET {{prodigy_board_API_HostAddress}}/api/v1/checklists?cardId={{checklistCardTwo}}

### Read them with archived=include. 200 with Steps, whose own flag is still off.
GET {{prodigy_board_API_HostAddress}}/api/v1/checklists?cardId={{checklistCardTwo}}&archived=include

### Restore the card.
PUT {{prodigy_board_API_HostAddress}}/api/v1/cards/{{checklistCardTwo}}/archived
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "value": false
}

### Archive the list the card is in.
PUT {{prodigy_board_API_HostAddress}}/api/v1/lists/{{checklistListTwo}}/archived
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "value": true
}

### Rename a checklist under the archived list. 409 archived with a null field, "The list this checklist is on is archived."
PUT {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistSteps}}
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "name": "Steps renamed"
}

### Restore the list.
PUT {{prodigy_board_API_HostAddress}}/api/v1/lists/{{checklistListTwo}}/archived
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "value": false
}

### Archive the board the card is on.
PUT {{prodigy_board_API_HostAddress}}/api/v1/boards/{{checklistBoardTwo}}/archived
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "value": true
}

### Rename a checklist under the archived board. 409 archived with a null field, "The board this checklist is on is archived."
PUT {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistSteps}}
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "name": "Steps renamed"
