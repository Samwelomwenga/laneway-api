### Create a card between two named siblings. The first card and the one after it are neighbours, so it's their midpoint, 81920.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "Between two cards",
  "after": "{{firstCardId}}",
  "before": "{{middleCardId}}",
  "listId": "{{placementListId}}",
  "isDueComplete": false
}

### Create a card at position 0. 400 outOfRange on position.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "Zero card",
  "position": 0,
  "listId": "{{placementListId}}",
  "isDueComplete": false
}

### Create a card at a name that isn't top or bottom. 400 unknownValue on position.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "Middle card",
  "position": "middle",
  "listId": "{{placementListId}}",
  "isDueComplete": false
}

### Send a card's position together with after. 400 mutuallyExclusive with a null field.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "Two meanings card",
  "position": "bottom",
  "after": "{{firstCardId}}",
  "listId": "{{placementListId}}",
  "isDueComplete": false
}

### Name a card anchor that doesn't exist. 400 notFound on before.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "Ghost anchor card",
  "before": "{{$uuid}}",
  "listId": "{{placementListId}}",
  "isDueComplete": false
}

### Name card anchors that aren't neighbours in that order. 400 notAdjacent on before.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "Wrong order card",
  "after": "{{bottomCardId}}",
  "before": "{{firstCardId}}",
  "listId": "{{placementListId}}",
  "isDueComplete": false
}

### Create the list the respread requests below use.
POST {{prodigy_board_API_HostAddress}}/api/v1/lists
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "name": "Respread",
  "boardId": "{{placementBoardId}}"
}

> {% client.global.set("respreadListId", response.body.data.id); %}

### Fill one gap. These two numbers are neighbouring doubles, so nothing fits between them. Halving a gap over and over reaches this state after about 52 drops.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "Gap floor",
  "position": 1,
  "listId": "{{respreadListId}}",
  "isDueComplete": false
}

> {% client.global.set("gapFloorCardId", response.body.data.id); %}

### The other side of the gap. It comes back as 1.0000000000000002.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "Gap ceiling",
  "position": 1.0000000000000002,
  "listId": "{{respreadListId}}",
  "isDueComplete": false
}

> {% client.global.set("gapCeilingCardId", response.body.data.id); %}

### Drop into that gap. No midpoint fits, so the list is respread and this card comes back at 131072.
POST {{prodigy_board_API_HostAddress}}/api/v1/cards
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "title": "No room",
  "after": "{{gapFloorCardId}}",
  "before": "{{gapCeilingCardId}}",
  "listId": "{{respreadListId}}",
  "isDueComplete": false
}

### Read the respread list. The three cards are at 65536, 131072 and 196608, in the order they were placed.
GET {{prodigy_board_API_HostAddress}}/api/v1/cards?listId={{respreadListId}}

