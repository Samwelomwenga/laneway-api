  "value": false
}

### Delete a checklist whose own flag is off. 409 notArchived with a null field.
DELETE {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistBetween}}
X-User-Id: {{actorId}}

### Archive it.
PUT {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistBetween}}/archived
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "value": true
}

### Delete the archived checklist. 204.
DELETE {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistBetween}}
X-User-Id: {{actorId}}

### Read the deleted checklist. 404.
GET {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistBetween}}

### Delete it again. 404.
DELETE {{prodigy_board_API_HostAddress}}/api/v1/checklists/{{checklistBetween}}
X-User-Id: {{actorId}}

