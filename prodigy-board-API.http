}

### Create the user who gets deleted.
POST {{prodigy_board_API_HostAddress}}/api/v1/users
Content-Type: application/json

{
  "username": "doomed-{{$uuid}}",
  "email": "{{$uuid}}@example.com",
  "firstName": "Doomed",
  "lastName": "User",
  "language": "en-US",
  "timeZone": "UTC",
  "location": "Nairobi"
}

> {%
client.global.set("doomedUserId", response.body.data.id);
client.global.set("doomedEmail", response.body.data.email);
client.global.set("doomedUsername", response.body.data.username);
%}

### Create a workspace as that user. Their work outlives them.
POST {{prodigy_board_API_HostAddress}}/api/v1/workspaces
X-User-Id: {{doomedUserId}}
Content-Type: application/json

{
  "name": "Work that outlives its author",
  "visibility": "Private"
}

> {% client.global.set("doomedWorkspaceId", response.body.data.id); %}

### Create a second account for that user. 201.
POST {{prodigy_board_API_HostAddress}}/api/v1/accounts
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "name": "Doomed account",
  "userId": "{{doomedUserId}}"
}

### Delete the user. 204, and the row stays behind.
DELETE {{prodigy_board_API_HostAddress}}/api/v1/users/{{doomedUserId}}
X-User-Id: {{actorId}}

### Read the deleted user. 404.
GET {{prodigy_board_API_HostAddress}}/api/v1/users/{{doomedUserId}}

### List users. The deleted user is gone from the page.
GET {{prodigy_board_API_HostAddress}}/api/v1/users?pageSize=100

### Write as the deleted user. 400 notFound on X-User-Id, the same answer an unknown user gets.
POST {{prodigy_board_API_HostAddress}}/api/v1/workspaces
X-User-Id: {{doomedUserId}}
Content-Type: application/json

{
  "name": "Written by a ghost",
  "visibility": "Private"
}

### Read the workspace they made. 200, because hiding a user never hides their work.
GET {{prodigy_board_API_HostAddress}}/api/v1/workspaces/{{doomedWorkspaceId}}

### List accounts. The deleted user's accounts are hidden with them.
GET {{prodigy_board_API_HostAddress}}/api/v1/accounts?pageSize=100

### Take the deleted user's email. 201, because the unique index only covers live users.
POST {{prodigy_board_API_HostAddress}}/api/v1/users
Content-Type: application/json

{
  "username": "heir-{{$uuid}}",
  "email": "{{doomedEmail}}",
  "firstName": "Email",
  "lastName": "Heir",
  "language": "en-US",
  "timeZone": "UTC",
  "location": "Nairobi"
}

### Take the deleted user's username. 201, because the duplicate check goes through the filter.
POST {{prodigy_board_API_HostAddress}}/api/v1/users
Content-Type: application/json

{
  "username": "{{doomedUsername}}",
  "email": "{{$uuid}}@example.com",
  "firstName": "Name",
  "lastName": "Heir",
  "language": "en-US",
  "timeZone": "UTC",
  "location": "Nairobi"
}

### Create an account for the deleted user. 400 notFound on userId.
POST {{prodigy_board_API_HostAddress}}/api/v1/accounts
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "name": "Account for a ghost",
  "userId": "{{doomedUserId}}"
}

