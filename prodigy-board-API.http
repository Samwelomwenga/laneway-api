{
  "listId": "{{moveListA1}}"
}

### Send card 1 to the bottom of its list. The largest sibling plus 65536, so 262144, and updatedBy becomes the actor.
PUT {{prodigy_board_API_HostAddress}}/api/v1/cards/{{moveCard1}}/position
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "listId": "{{moveListA1}}",
  "position": "bottom"
}

### Send it back to the top. The smallest sibling halved, and card 1 isn't its own sibling, so it's 131072 / 2 = 65536.
PUT {{prodigy_board_API_HostAddress}}/api/v1/cards/{{moveCard1}}/position
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "listId": "{{moveListA1}}",
  "position": "top"
}

### Drop card 1 after card 2. Card 2 and card 3 are neighbours once card 1 is out of the way, so it's their midpoint, 163840.
PUT {{prodigy_board_API_HostAddress}}/api/v1/cards/{{moveCard1}}/position
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "listId": "{{moveListA1}}",
  "after": "{{moveCard2}}"
}

### Drop card 1 before card 2. Nothing sits above card 2 now, so it's 131072 / 2 = 65536.
PUT {{prodigy_board_API_HostAddress}}/api/v1/cards/{{moveCard1}}/position
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "listId": "{{moveListA1}}",
  "before": "{{moveCard2}}"
}

### Drop card 1 between card 2 and card 3. Their midpoint, 163840.
PUT {{prodigy_board_API_HostAddress}}/api/v1/cards/{{moveCard1}}/position
X-User-Id: {{actorId}}
Content-Type: application/json

{
  "listId": "{{moveListA1}}",
  "after": "{{moveCard2}}",
  "before": "{{moveCard3}}"
