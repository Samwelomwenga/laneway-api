### Give the second user the first user's email. User update has no duplicate check, so the unique index on Email fails and the exception handler returns 409 duplicate with a null field.
PUT {{prodigy_board_API_HostAddress}}/api/v1/users/{{secondUserId}}
Content-Type: application/json

{
  "username": "second-{{$uuid}}",
  "email": "{{takenEmail}}",
  "firstName": "Second",
  "lastName": "User",
  "language": "en-US",
  "timeZone": "UTC",
  "location": "Nairobi",
  "isActive": true
}
